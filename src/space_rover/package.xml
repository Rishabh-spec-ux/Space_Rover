<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>space_rover</name>
  <version>0.1.0</version>
  <description>
    Core package for the Space Rover workspace. This package is intended to hold
    rover-side nodes, interfaces, and runtime integration logic, while visual and
    simulation assets are kept in space_rover_description.
  </description>
  <maintainer email="rishabhnrudani@gmail.com">rishabh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>space_rover_description</exec_depend>

  <url type="repository">https://github.com/&lt;your-username&gt;/space_rover</url>
  <url type="bugtracker">https://github.com/&lt;your-username&gt;/space_rover/issues</url>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
